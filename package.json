{
  "name": "facebook-demo",
  "version": "1.0.0",
  "description": "Playwright UI + API automation demo for Facebook, mirroring the qa_automation_base framework structure",
  "main": "index.js",
  "scripts": {
    "allure:env": "node scripts/generate-allure-env.js",
    "allure:summary": "node scripts/allure-module-summary.js",
    "allure:notify": "node scripts/notifyTeammates.js",
    "allure:generate": "node scripts/generate-allure-env.js && allure generate allure-results --clean -o allure-report",
    "allure:full": "node scripts/generate-allure-env.js && allure generate allure-results --clean -o allure-report && node scripts/notifyTeammates.js",
    "allure:open": "allure open allure-report",
    "allure:serve": "node scripts/generate-allure-env.js && allure serve allure-results",
    "allure:clean": "rimraf allure-results allure-report",
    "clean:all": "rimraf allure-results allure-report test-results playwright-report",
    "auth:save": "node testdata/save-auth-state.js",
    "auth:save:dev": "ENV=dev node testdata/save-auth-state.js"
  },
  "keywords": [
    "playwright",
    "automation",
    "facebook",
    "page-object-model"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "8.4.1",
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.0.3",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "rimraf": "^6.1.2"
  },
  "dependencies": {
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.2.4",
    "xlsx": "^0.18.5"
  }
}
